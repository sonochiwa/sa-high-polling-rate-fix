        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "sonochiwa"
            VALUE "FileDescription", "High Polling Rate Fix"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "HighPollingRateFix"
            VALUE "LegalCopyright", "Copyright (c) 2026 Rashid Mamarimov (sonochiwa)"
            VALUE "OriginalFilename", "HighPollingRateFix.asi"
            VALUE "ProductName", "High Polling Rate Fix"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
